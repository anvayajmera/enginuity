{
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://www.enginuitystem.com/$1",
      "has": [
        { "type": "host", "value": "enginuitystem.com" }
      ],
      "statusCode": 301,
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/:path*.:ext", "destination": "/:path*.:ext" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}

