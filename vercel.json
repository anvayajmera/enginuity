{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "/club",
      "destination": "/impact",
      "statusCode": 308
    },
    {
      "source": "/club/:path*",
      "destination": "/impact/:path*",
      "statusCode": 308
    },
    {
      "source": "/unwork",
      "destination": "/united-nations",
      "statusCode": 308
    },
    {
      "source": "/unwork/:path*",
      "destination": "/united-nations/:path*",
      "statusCode": 308
    },
    {
      "source": "/about",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "/about/:path*",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "/njfbla",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "/njfbla/:path*",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "\/(.*)",
      "destination": "https://www.enginuitystem.com/$1",
      "has": [
        { "type": "host", "value": "enginuitystem.com" }
      ],
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/impact", "destination": "/impact.html" },
    { "source": "/united-nations", "destination": "/united-nations.html" },
    { "source": "/gallery", "destination": "/gallery.html" },
    { "source": "/siblings-keeper", "destination": "/siblings-keeper.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/:path*.:ext", "destination": "/:path*.:ext" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
